# Supabase project URL and anon key (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL= # Your Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Your Supabase anonymous key

# Supabase project URL and anon key (server-side reference; same values as above)
SUPABASE_URL= # Your Supabase project URL
SUPABASE_ANON_KEY= # Your Supabase anon key

# Supabase service role key (server-side only; bypasses RLS - not used in this project)
# The preview does not provide this key; all database access goes through RLS as the signed-in user.
SUPABASE_SERVICE_ROLE_KEY=

# AI provider configuration (server-side only; never prefix with NEXT_PUBLIC_)
AI_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
