# Supabase project URL and anon key (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL= # Your Supabase project URL, e.g. https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Your Supabase anonymous key

# Supabase project URL and anon key (server-side reference; same values as above)
SUPABASE_URL= # Your Supabase project URL
SUPABASE_ANON_KEY= # Your Supabase anon key

# AI provider (server-side only; never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY= # Google AI Studio key, used by /api/parse
# AI_MODEL= # optional; defaults to the model in lib/ai/config.ts

# Not used: no service role key (all database access goes through RLS as the signed-in user)
